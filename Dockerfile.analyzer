FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/analyzer ./services/analyzer/cmd/analyzer

FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /out/analyzer /app/analyzer
ENV HTTP_ADDR=:8082
EXPOSE 8082
USER nonroot:nonroot
ENTRYPOINT ["/app/analyzer"]
